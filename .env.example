# Пример .env. Обычно его создаёт install.sh — вручную заполнять не нужно.
# После правки примените изменения: docker compose up -d

# С доменом: docker-compose.yml:docker-compose.tls.yml (порт 80 для Let's Encrypt)
COMPOSE_FILE=docker-compose.yml
# Тег образа bridge: latest или версия релиза, например 2.0.0
BRIDGE_VERSION=latest

# Адрес сервера: домен (HTTPS) или IPv4 (HTTP) — заполняется одно из двух
DOMAIN=
HOST_IP=1.2.3.4
# Порт TorrServer UI и потоков; порт WebDAV для Infuse
TS_PORT=51234
WEBDAV_PORT=8080

# Внешний адрес для ссылок на потоки:
#   с доменом — https://media.example.com (или https://media.example.com:ПОРТ, если TS_PORT не 443)
#   без домена — http://HOST_IP:TS_PORT
PUBLIC_URL=http://1.2.3.4:51234
# Адреса сайтов Caddy:
#   с доменом — https://media.example.com:TS_PORT и https://media.example.com:WEBDAV_PORT
#   без домена — http://:TS_PORT и http://:WEBDAV_PORT
TS_SITE=http://:51234
DAV_SITE=http://:8080

# Логин и пароль для WebDAV и TorrServer UI. Одинарные кавычки обязательны,
# одинарная кавычка внутри пароля недопустима. Логин: латиница, цифры, . _ -
AUTH_USER='admin'
AUTH_PASSWORD='changeme'

# Секрет в ссылках на потоки (не короче 16 символов: латиница, цифры, - _).
# Сгенерировать: od -An -tx1 -N24 /dev/urandom | tr -d ' \n'
STREAM_TOKEN=change-me-to-a-random-token

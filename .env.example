# Порт WebDAV-сервера (Infuse подключается по этому порту)
WEBDAV_PORT=8080

# Логин для доступа к WebDAV и TorrServer UI
WEBDAV_USER=admin

# Пароль для доступа к WebDAV и TorrServer UI
WEBDAV_PASSWORD=changeme

# Внешний IP-адрес сервера (вписывается в .strm-файлы, Infuse обращается по этому адресу)
HOST_IP=1.2.3.4

# Публичный порт TorrServer (через Nginx-прокси с аутентификацией)
TORR_PORT=51234

# Внутреннее имя хоста TorrServer в Docker-сети.
# Обычно менять не нужно: значение по умолчанию подходит для штатного docker-compose.
# Полезно при локальном запуске parser вне compose или в нестандартной сети.
# TORR_HOST=torrserver

# Порт WebDAV-сервера (Infuse подключается по этому порту)
WEBDAV_PORT=8080

# Логин для доступа к WebDAV и TorrServer UI (без пробелов, двоеточия и одинарной кавычки)
WEBDAV_USER='admin'

# Пароль для доступа к WebDAV и TorrServer UI.
# Одинарные кавычки обязательны: внутри них $, #, пробелы не раскрываются. Сама кавычка (') недопустима.
WEBDAV_PASSWORD='changeme'

# Внешний IPv4-адрес сервера (вписывается в .strm-файлы, Infuse обращается по этому адресу)
HOST_IP=1.2.3.4

# Публичный порт TorrServer (через Nginx-прокси с аутентификацией)
TORR_PORT=51234

# Внутреннее имя хоста TorrServer в Docker-сети.
# Обычно менять не нужно: значение по умолчанию подходит для штатного docker-compose.
# Используется и парсером, и Nginx-прокси (nginx.conf генерируется install.sh).
# Install.sh сохраняет эту строку при пересоздании .env.
# TORR_HOST=torrserver
